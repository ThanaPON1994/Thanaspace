                -- UI elements (breaking Yaw Settings kebab lookup, color pickers, etc.)
                if not (cn:find("Krazz") or cn:find(SECURE_ID)) then
                    table.insert(filtered, child)
                end
            end
            return filtered
        end
    end
    return old_nc(t, ...)
end)
